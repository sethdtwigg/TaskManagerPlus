<?xml version="1.0" encoding="utf-8"?>
<!-- TaskManagerPlus: offline builds. No remote source is configured; every package must come from the global
     packages folder or from the local feed below. Create the feed once with tools\make-offline-packages.ps1
     (see docs/plugin-dev.md, "Offline package cache"). -->
<configuration>
  <packageSources>
    <clear />
    <add key="offline-packages" value="..\offline-packages" />
  </packageSources>
</configuration>

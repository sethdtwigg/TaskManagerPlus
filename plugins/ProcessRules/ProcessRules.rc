#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_RULE DIALOGEX 0, 0, 350, 262
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "Process rule"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Program name:",IDC_STATIC,7,9,55,8
    EDITTEXT        IDC_PROGRAM,65,7,222,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BROWSE,293,6,50,14
    LTEXT           "Path contains:",IDC_STATIC,7,26,55,8
    EDITTEXT        IDC_MATCHPATH,65,24,278,12,ES_AUTOHSCROLL
    CONTROL         "Rule enabled",IDC_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,65,41,100,10
    GROUPBOX        "When the program starts",IDC_STATIC,7,56,336,72
    LTEXT           "Priority:",IDC_STATIC,14,72,40,8
    COMBOBOX        IDC_PRIORITY,56,70,95,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Affinity:",IDC_STATIC,160,72,40,8
    COMBOBOX        IDC_AFFINITY,200,70,136,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Efficiency mode (power throttling)",IDC_ECO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,88,150,10
    CONTROL         "End the process immediately (block)",IDC_ENDONSTART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,170,88,166,10
    LTEXT           "Run command:",IDC_STATIC,14,106,50,8
    EDITTEXT        IDC_COMMAND,66,104,270,12,ES_AUTOHSCROLL
    LTEXT           "Command tokens: {pid} {name} {path}",IDC_HYBRIDNOTE,66,118,270,8
    GROUPBOX        "Watchdogs (when a condition holds for the given time, run the action)",IDC_STATIC,7,134,336,100
    LTEXT           "On",IDC_STATIC,14,146,14,8
    LTEXT           "Metric",IDC_STATIC,30,146,60,8
    LTEXT           "Threshold",IDC_STATIC,100,146,45,8
    LTEXT           "For (sec)",IDC_STATIC,185,146,40,8
    LTEXT           "Action",IDC_STATIC,230,146,60,8
    CONTROL         "",IDC_WD_ENABLE0,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,159,12,10
    COMBOBOX        IDC_WD_METRIC0,30,157,65,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_WD_THRESHOLD0,100,157,45,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_WD_UNIT0,150,159,30,8
    EDITTEXT        IDC_WD_DURATION0,185,157,35,12,ES_AUTOHSCROLL | ES_NUMBER
    COMBOBOX        IDC_WD_ACTION0,230,157,105,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_WD_ENABLE1,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,177,12,10
    COMBOBOX        IDC_WD_METRIC1,30,175,65,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_WD_THRESHOLD1,100,175,45,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_WD_UNIT1,150,177,30,8
    EDITTEXT        IDC_WD_DURATION1,185,175,35,12,ES_AUTOHSCROLL | ES_NUMBER
    COMBOBOX        IDC_WD_ACTION1,230,175,105,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_WD_ENABLE2,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,195,12,10
    COMBOBOX        IDC_WD_METRIC2,30,193,65,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_WD_THRESHOLD2,100,193,45,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_WD_UNIT2,150,195,30,8
    EDITTEXT        IDC_WD_DURATION2,185,193,35,12,ES_AUTOHSCROLL | ES_NUMBER
    COMBOBOX        IDC_WD_ACTION2,230,193,105,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_WD_ENABLE3,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,213,12,10
    COMBOBOX        IDC_WD_METRIC3,30,211,65,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_WD_THRESHOLD3,100,211,45,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_WD_UNIT3,150,213,30,8
    EDITTEXT        IDC_WD_DURATION3,185,211,35,12,ES_AUTOHSCROLL | ES_NUMBER
    COMBOBOX        IDC_WD_ACTION3,230,211,105,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,239,241,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,293,241,50,14
END

IDD_OPTIONS DIALOGEX 0, 0, 317, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "Options"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Enable the process rules engine",IDC_ENGINE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,7,220,10
    CONTROL         "Show a notification when a rule fires",IDC_NOTIFY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,21,220,10
    CONTROL         "Write rule events to the log",IDC_LOG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,35,220,10
    LTEXT           "Pause all rules after this many end/suspend actions per minute:",IDC_STATIC,7,55,230,8
    EDITTEXT        IDC_GUARD_GLOBAL,245,53,40,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Disable a rule after this many end actions per minute:",IDC_STATIC,7,71,230,8
    EDITTEXT        IDC_GUARD_RULE,245,69,40,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Maximum dump files per hour:",IDC_STATIC,7,87,230,8
    EDITTEXT        IDC_DUMPS,245,85,40,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Dump directory (blank for the default):",IDC_STATIC,7,103,130,8
    EDITTEXT        IDC_DUMPDIR,140,101,170,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_RULESFILE,7,125,303,18
END

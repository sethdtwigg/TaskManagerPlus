#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// TaskManagerPlus: Segoe UI 9, 5/4 dialog-unit margins (about 8px), 17 dlu row pitch
IDD_RULE DIALOGEX 0, 0, 372, 270
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "Process rule"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Program name:",IDC_STATIC,5,7,62,8
    EDITTEXT        IDC_PROGRAM,70,5,225,13,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BROWSE,300,5,67,13
    LTEXT           "Path contains:",IDC_STATIC,5,24,62,8
    EDITTEXT        IDC_MATCHPATH,70,22,297,13,ES_AUTOHSCROLL
    CONTROL         "Rule enabled",IDC_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,70,40,120,10
    GROUPBOX        "When the program starts",IDC_STATIC,5,56,362,82
    LTEXT           "Priority:",IDC_STATIC,10,74,36,8
    COMBOBOX        IDC_PRIORITY,48,72,90,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Affinity:",IDC_STATIC,148,74,36,8
    COMBOBOX        IDC_AFFINITY,186,72,176,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Efficiency mode (power throttling)",IDC_ECO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,90,150,10
    CONTROL         "End the process immediately (block)",IDC_ENDONSTART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,166,90,196,10
    LTEXT           "Run command:",IDC_STATIC,10,108,50,8
    EDITTEXT        IDC_COMMAND,62,106,300,13,ES_AUTOHSCROLL
    LTEXT           "Command tokens: {pid} {name} {path}",IDC_HYBRIDNOTE,62,122,300,10
    GROUPBOX        "Watchdogs (when a condition holds for the given time, run the action)",IDC_STATIC,5,144,362,100
    LTEXT           "On",IDC_STATIC,10,160,16,8
    LTEXT           "Metric",IDC_STATIC,28,160,60,8
    LTEXT           "Threshold",IDC_STATIC,94,160,50,8
    LTEXT           "For (sec)",IDC_STATIC,190,160,40,8
    LTEXT           "Action",IDC_STATIC,236,160,60,8
    CONTROL         "",IDC_WD_ENABLE0,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,177,12,10
    COMBOBOX        IDC_WD_METRIC0,28,175,62,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_WD_THRESHOLD0,94,175,48,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_WD_UNIT0,146,177,40,8
    EDITTEXT        IDC_WD_DURATION0,190,175,40,13,ES_AUTOHSCROLL | ES_NUMBER
    COMBOBOX        IDC_WD_ACTION0,236,175,126,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_WD_ENABLE1,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,194,12,10
    COMBOBOX        IDC_WD_METRIC1,28,192,62,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_WD_THRESHOLD1,94,192,48,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_WD_UNIT1,146,194,40,8
    EDITTEXT        IDC_WD_DURATION1,190,192,40,13,ES_AUTOHSCROLL | ES_NUMBER
    COMBOBOX        IDC_WD_ACTION1,236,192,126,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_WD_ENABLE2,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,211,12,10
    COMBOBOX        IDC_WD_METRIC2,28,209,62,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_WD_THRESHOLD2,94,209,48,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_WD_UNIT2,146,211,40,8
    EDITTEXT        IDC_WD_DURATION2,190,209,40,13,ES_AUTOHSCROLL | ES_NUMBER
    COMBOBOX        IDC_WD_ACTION2,236,209,126,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_WD_ENABLE3,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,228,12,10
    COMBOBOX        IDC_WD_METRIC3,28,226,62,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_WD_THRESHOLD3,94,226,48,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_WD_UNIT3,146,228,40,8
    EDITTEXT        IDC_WD_DURATION3,190,226,40,13,ES_AUTOHSCROLL | ES_NUMBER
    COMBOBOX        IDC_WD_ACTION3,236,226,126,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,257,250,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,312,250,55,14
END

IDD_OPTIONS DIALOGEX 0, 0, 312, 146
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "Options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "Enable the process rules engine",IDC_ENGINE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,5,300,10
    CONTROL         "Show a notification when a rule fires",IDC_NOTIFY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,19,300,10
    CONTROL         "Write rule events to the log",IDC_LOG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,33,300,10
    LTEXT           "Pause all rules after this many end/suspend actions per minute:",IDC_STATIC,5,52,252,8
    EDITTEXT        IDC_GUARD_GLOBAL,262,50,40,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Disable a rule after this many end actions per minute:",IDC_STATIC,5,69,252,8
    EDITTEXT        IDC_GUARD_RULE,262,67,40,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Maximum dump files per hour:",IDC_STATIC,5,86,252,8
    EDITTEXT        IDC_DUMPS,262,84,40,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Dump directory (blank for the default):",IDC_STATIC,5,103,130,8
    EDITTEXT        IDC_DUMPDIR,140,101,167,13,ES_AUTOHSCROLL
    LTEXT           "",IDC_RULESFILE,5,120,302,20
END

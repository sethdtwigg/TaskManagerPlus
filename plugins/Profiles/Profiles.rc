#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_SAVE_PROFILE DIALOGEX 0, 0, 240, 128
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Save profile"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Profile name:",-1,7,9,226,8
    EDITTEXT        IDC_PROFILE_NAME,7,20,226,14,ES_AUTOHSCROLL
    LTEXT           "Include from the current settings:",-1,7,43,226,8
    CONTROL         "Which Process Rules are on or off",IDC_CAP_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,55,219,10
    CONTROL         "The start priority of each rule",IDC_CAP_PRIORITY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,68,219,10
    CONTROL         "The theme (automatic, light, dark or OLED)",IDC_CAP_THEME,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,81,219,10
    DEFPUSHBUTTON   "Save",IDOK,129,106,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,183,106,50,14
END

IDD_MANAGE_PROFILES DIALOGEX 0, 0, 290, 168
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Profiles"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_PROFILE_LIST,7,7,170,100,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Apply",IDC_APPLY,183,7,100,14
    PUSHBUTTON      "Revert to previous",IDC_REVERT,183,25,100,14
    PUSHBUTTON      "Delete",IDC_DELETE,183,43,100,14
    PUSHBUTTON      "Export...",IDC_EXPORT,183,69,100,14
    PUSHBUTTON      "Import...",IDC_IMPORT,183,87,100,14
    LTEXT           "",IDC_PROFILE_INFO,7,114,276,30
    DEFPUSHBUTTON   "Close",IDOK,233,147,50,14
END

// TaskManagerPlus: Segoe UI 9, 5/4 dialog-unit margins (about 8px)
IDD_OPTIONS DIALOGEX 0, 0, 270, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "Process History"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Snapshot interval (seconds):",IDC_STATIC,5,7,125,8
    EDITTEXT        IDC_INTERVAL,135,5,60,13,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Retention (hours):",IDC_STATIC,5,24,125,8
    EDITTEXT        IDC_RETENTION,135,22,60,13,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Persist history to disk",IDC_PERSIST,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,41,160,10
    CONTROL         "Capture short-lived processes between refreshes (needs administrator)",IDC_CAPTURE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,56,260,10
    LTEXT           "Snapshots are taken from the process list on the main refresh cycle. History older than the retention period is discarded. Capture uses a local ETW session; without administrator rights it stays off and says so in the log.",IDC_STATIC,5,73,260,42
